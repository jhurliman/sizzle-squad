node_modules/
dist/

# Harness output. Every shoot.mjs run writes a directory of JPEGs here.
# Thousands of them; none belong in git.
shots/

# Scratch crops and side-by-sides left by probes.
tmp-*/
tmp-*.jpg
tmp-*.png

# progress/index.html is generated from progress/status.json by tools/progress.mjs
# and inlines base64 thumbnails, so it is large and regenerable.
progress/index.html

.DS_Store
*.log

# Open Cloud credentials live at ~/.config/sizzle/opencloud.json, never here.
# These patterns are a backstop in case anyone puts one in the tree anyway.
opencloud.json
.env
.env.*
*.apikey
*.rbxl.lock

# ---------------------------------------------------------------- generated art
#
# WHAT GETS COMMITTED IS A DECISION, NOT AN ACCIDENT.
#
# A batch of animation sheets was committed by mistake because the tools that
# made them wrote PNGs into roblox/ alongside their own source. Every render
# tool now writes to a dedicated output directory, and the split is:
#
#   COMMITTED (via Git LFS, see .gitattributes) — art that was UPLOADED to
#   Roblox or is under review for upload, plus reference material. The exact
#   bytes that went to the platform are worth keeping:
#     roblox/badge-art/  roblox/game-icon/  roblox/pass-art/
#     roblox/game-banner/  docs/final-shots/  docs/art/  refs/
#
#   NOT COMMITTED — developer instruments. Every one of these is regenerable
#   from a script in roblox/ and none of them is an input to anything:
roblox/preview/
roblox/render-*.png
roblox/viewer.html
#
#   Intermediates and contact sheets inside the committed dirs. The `_` prefix
#   already marked them; this makes the mark mean something. They are review
#   aids regenerated by the same script that writes the finals.
roblox/*/_*.png
