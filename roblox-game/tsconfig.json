{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "rootDir": ".",
    "outDir": "out"
  },
  "include": ["src/shared"],
  "tstl": {
    "luaTarget": "5.1",
    "luaBundle": "shared-bundle.lua",
    "luaBundleEntry": "src/shared/index.ts",
    "luaLibImport": "require",
    "noImplicitSelf": true,
    "luaPlugins": [{ "name": "./tstl-bit32.cjs" }]
  }
}
