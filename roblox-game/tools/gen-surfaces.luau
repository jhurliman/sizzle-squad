-- Emits client/SurfaceH.luau: the real work-surface height of every station,
-- measured from the captured kitchen.
--
-- StationVisuals used one hand-tuned height per station KIND. Bounding boxes
-- were rejected for good reason (station models carry tall dressing -- plate
-- stacks, the serve counters' Toad -- which floats items a whole counter too
-- high), but a flat per-kind table is wrong in the other direction: the floor
-- benches top out at 0.37-0.45 cells while `counter` assumed 0.55, so a plate
-- put down on one hovered ~0.9 studs in the air, level with the middle of the
-- plate stack beside it. That is the "plate stuck halfway into the pot".
--
-- The heuristic ignores dressing WITHOUT ignoring the surface: take the part
-- with the largest horizontal footprint (the work surface is always the widest
-- flat thing on a station), not the tallest.
local fs = require("@lune/fs")
local roblox = require("@lune/roblox")

local SCALE = 5
local root = roblox.deserializeModel(fs.readFile("assets/kitchen.rbxm"))[1]

--- The work surface is the HIGHEST reasonably-wide flat part.
---
--- "Widest" alone is not enough: a chopping board's slab sits on top of a
--- bench whose top is wider, so widest-wins measured the bench and buried the
--- item inside the board. "Highest" alone is not enough either: that is what
--- picks the Toad on a serve counter. Highest among the wide ones is both.
local function surfaceOf(m: Instance): number?
	local flat = {}
	local maxArea = 0
	for _, p in m:GetDescendants() do
		if not p:IsA("BasePart") then
			continue
		end
		local size = p.Size
		-- Skip anything taller than it is wide: legs, faucets, chimneys.
		if size.Y > math.min(size.X, size.Z) * 1.6 then
			continue
		end
		local top = (p.CFrame.Position.Y + size.Y / 2) / SCALE
		if top <= 0.15 or top >= 1.4 then
			continue
		end
		local area = size.X * size.Z
		maxArea = math.max(maxArea, area)
		table.insert(flat, { area = area, top = top })
	end
	if maxArea <= 0 then
		return nil
	end
	local best = nil
	for _, f in flat do
		if f.area >= maxArea * 0.35 and (best == nil or f.top > best) then
			best = f.top
		end
	end
	return best
end

local byCell: { [string]: number } = {}
for _, group in root:GetChildren() do
	if group.Name ~= "Stations" and group.Name ~= "Benches" then
		continue
	end
	for _, m in group:GetChildren() do
		local kind, cx, cy = m.Name:match("^(%a+)_(%d+)_(%d+)$")
		if kind == nil then
			continue
		end
		local top
		if group.Name == "Benches" then
			-- Benches carry no dressing in the capture (verified: nothing in
			-- Dressing sits above 0.25 cells), so their true top IS the work
			-- surface. Used for the floor counters, which have no Station
			-- model of their own.
			top = -math.huge
			for _, p in m:GetDescendants() do
				if p:IsA("BasePart") then
					top = math.max(top, (p.CFrame.Position.Y + p.Size.Y / 2) / SCALE)
				end
			end
			if top == -math.huge then
				top = nil
			end
		else
			top = surfaceOf(m)
		end
		if top == nil then
			continue
		end
		local key = `{cx},{cy}`
		-- A Station model wins over the Bench under it.
		if group.Name == "Stations" or byCell[key] == nil then
			byCell[key] = top
		end
	end
end

local keys = {}
for k in byCell do
	table.insert(keys, k)
end
table.sort(keys)

local out = {
	"--!strict",
	"-- GENERATED by tools/gen-surfaces.luau -- do not edit by hand.",
	"--",
	"-- Work-surface height per station cell, in sim units, measured off the",
	"-- captured kitchen (the widest flat part of each station, which ignores",
	"-- tall dressing without ignoring the surface). Regenerate after any change",
	"-- to the kitchen capture.",
	"",
	"return {",
}
for _, k in keys do
	table.insert(out, string.format("\t[\"%s\"] = %.3f,", k, byCell[k]))
end
table.insert(out, "}")
fs.writeFile("game-src/client/SurfaceH.luau", table.concat(out, "\n") .. "\n")
print(`wrote {#keys} station surfaces`)
for _, k in keys do
	print(string.format("  %-7s %.2f", k, byCell[k]))
end
